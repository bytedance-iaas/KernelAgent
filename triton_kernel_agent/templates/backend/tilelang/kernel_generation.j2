import torch
import tilelang
import tilelang.language as T
from functools import lru_cache


@lru_cache(maxsize=None)
def _get_kernel(n: int, dtype: str, block_size: int = 256):
    @tilelang.jit
    def _build_kernel(n: int, dtype: str, block_size: int):
        @T.prim_func
        def main(x: T.Tensor((n,), dtype), out: T.Tensor((n,), dtype)):
            with T.Kernel(T.ceildiv(n, block_size), threads=block_size) as bx:
                for tx in T.Parallel(block_size):
                    idx = bx * block_size + tx
                    if idx < n:
                        # Replace with real TileLang compute.
                        out[idx] = x[idx]

        return main

    return _build_kernel(n, dtype, block_size)


def kernel_function(x):
    out = torch.empty_like(x)
    n = x.numel()
    kernel = _get_kernel(n, str(x.dtype).replace("torch.", ""))
    kernel(x, out)
    return out
```

PREFERRED GEMM-LIKE SKELETON TO ADAPT WHEN RELEVANT:
